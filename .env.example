# 로컬 개발
# Builder를 로컬에서 실행할 때 사용하는 PostgreSQL 연결 주소입니다.
DATABASE_URL=postgresql://astral_patch:PASSWORD@127.0.0.1:5432/astral_patch

# GitHub Actions - Repository Secrets
# 패치 workflow가 SSH 터널을 통해 접속하는 PostgreSQL 연결 주소입니다.
ASTRAL_DATABASE_URL=postgresql://astral_patch:PASSWORD@127.0.0.1:55432/astral_patch

# DB 및 patch watcher 서버에 접속하기 위한 SSH 정보입니다.
DB_SSH_HOST=<서버 주소>
DB_SSH_USER=ubuntu
DB_SSH_PRIVATE_KEY=<SSH 개인 키>
DB_SSH_KNOWN_HOSTS=<DB_SSH_HOST의 known_hosts 항목>

# main 배포 시 patch watcher 저장소가 위치한 서버 경로입니다.
PATCH_SERVER_WORK_DIR=/home/ubuntu/astral-party-korean-patch

# Steam 원본 파일 다운로드에 사용하는 계정 정보입니다.
STEAM_USERNAME=<Steam 계정>
STEAM_REFRESH_TOKEN=<DepotDownloader 로그인 토큰>

# Patch watcher 서버 .env
# watcher가 접속할 PostgreSQL 주소와 자동 패치 이벤트를 보낼 GitHub 토큰입니다.
DATABASE_URL=postgresql://astral_patch:PASSWORD@postgres-db:5432/astral_patch
GITHUB_TOKEN=<이 저장소의 Contents 쓰기 권한이 있는 fine-grained 토큰>
