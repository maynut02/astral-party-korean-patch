# Astral Party Korean Patch - GitHub repository configuration
#
# 이 파일에는 실제 비밀값을 넣지 마세요.
# 아래 이름을 GitHub Repository Settings > Secrets and variables > Actions에 등록합니다.

# -----------------------------------------------------------------------------
# GitHub Actions Secrets
# -----------------------------------------------------------------------------

# Neon PostgreSQL pooled connection URL.
# Builder의 일반 읽기/쓰기 작업에서 사용합니다.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Neon PostgreSQL direct connection URL.
# database/migrate.py가 migration을 적용할 때 사용합니다.
NEON_DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Astral Party를 소유한 Steam 계정 이름.
# 비밀번호는 GitHub에 등록하지 않습니다.
STEAM_USERNAME="your-steam-account-name"

# scripts/bootstrap-steam-token.sh로 생성한 persistent Steam refresh token.
# 토큰 내용을 채팅, 로그, Git에 남기지 마세요.
STEAM_REFRESH_TOKEN="your-steam-refresh-token"

# INT Android APK를 Google Play에서 다운로드할 Google 계정 이메일.
# 가능하면 이 자동화 전용 계정을 사용하세요.
PLAY_EMAIL="your-google-play-account@gmail.com"

# apkeep Google Play 인증에 사용하는 AAS token.
# OAuth token에서 변환한 장기 토큰이며 채팅, 로그, Git에 남기지 마세요.
AAS_TOKEN="your-google-play-aas-token"

# INT Android 한국어 APK 서명 keystore 파일의 Base64 전체 문자열.
# 실제 keystore 파일 자체를 저장소에 commit하지 마세요.
ANDROID_KEYSTORE_BASE64="base64-encoded-android-keystore"

# 위 keystore의 저장소 비밀번호.
ANDROID_KEYSTORE_PASSWORD="your-keystore-password"

# 한국어 APK 서명에 사용할 key alias.
ANDROID_KEY_ALIAS="astralparty"

# 위 alias의 private key 비밀번호.
ANDROID_KEY_PASSWORD="your-key-password"

# -----------------------------------------------------------------------------
# GitHub Actions Repository Variable (Secret이 아님)
# -----------------------------------------------------------------------------

# hotaddress/catalog 탐색에 사용할 현재 게임 semantic version.
GAME_VERSION="3.2.0"

# -----------------------------------------------------------------------------
# 별도 등록이 필요 없는 값
# -----------------------------------------------------------------------------
# DATABASE_URL        : workflow가 NEON_DATABASE_URL을 이 이름으로 매핑합니다.
# DATABASE_URL_DIRECT : workflow가 NEON_DATABASE_URL_DIRECT를 이 이름으로 매핑합니다.
# GH_TOKEN            : GitHub Actions의 github.token을 workflow가 자동으로 사용합니다.
# GITHUB_TOKEN        : GitHub Actions가 자동으로 제공합니다.
