# 1. GitHub Repository secrets
#
# ASTRAL_DATABASE_URL=postgresql://astral_patch:PASSWORD@127.0.0.1:55432/astral_patch
# DB_SSH_HOST=<VM public IP or SSH hostname>
# DB_SSH_USER=ubuntu
# DB_SSH_PRIVATE_KEY=<database tunnel SSH private key>
# DB_SSH_KNOWN_HOSTS=<known_hosts entry for DB_SSH_HOST>
#
# STEAM_USERNAME=<Steam account>
# STEAM_REFRESH_TOKEN=<DepotDownloader refresh/login token>
#
# PLAY_EMAIL=<Google Play account email>
# AAS_TOKEN=<Google Play AAS token>
#
# ANDROID_KEYSTORE_BASE64=<base64 encoded keystore>
# ANDROID_KEYSTORE_PASSWORD=<keystore password>
# ANDROID_KEY_ALIAS=astralparty
# ANDROID_KEY_PASSWORD=<key password>
#
# GAME_VERSION=3.2.0