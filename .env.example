# Astral Party Korean Patch - environment variable reference
#
# 실제 비밀값을 이 파일에 넣지 마세요.
# GitHub Actions에서 사용하는 값은 Repository Settings > Secrets and variables > Actions에 등록합니다.

# -----------------------------------------------------------------------------
# GitHub Actions Secrets
# -----------------------------------------------------------------------------

# Neon PostgreSQL pooled connection URL.
NEON_DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"

# Neon PostgreSQL direct connection URL. migration 및 대량 동기화에 사용합니다.
NEON_DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# Astral Party를 소유한 Steam 계정과 DepotDownloader refresh token.
STEAM_USERNAME="your-steam-account-name"
STEAM_REFRESH_TOKEN="your-steam-refresh-token"

# INT_ANDROID 원본 APK를 Google Play에서 내려받을 계정과 apkeep AAS token.
PLAY_EMAIL="your-google-play-account@gmail.com"
AAS_TOKEN="your-google-play-aas-token"

# INT_ANDROID 빌드 서명 정보.
ANDROID_KEYSTORE_BASE64="base64-encoded-android-keystore"
ANDROID_KEYSTORE_PASSWORD="your-keystore-password"
ANDROID_KEY_ALIAS="astralparty"
ANDROID_KEY_PASSWORD="your-key-password"

# -----------------------------------------------------------------------------
# GitHub Actions Repository Variable
# -----------------------------------------------------------------------------

# 현재 게임 semantic version. Patch workflow의 revision/catalog 탐색 기준입니다.
GAME_VERSION="3.2.0"

# -----------------------------------------------------------------------------
# Local development aliases
# -----------------------------------------------------------------------------
#
# Builder CLI는 DATABASE_URL / DATABASE_URL_DIRECT를 사용합니다.
# 로컬에서 작업할 때 위 Neon URL을 다음 이름으로 export하면 됩니다.
# 이 저장소는 .env 파일을 자동으로 로드하지 않습니다.

DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST/DATABASE?sslmode=require"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require"

# GitHub API를 사용하는 로컬 도구를 직접 실행할 때만 필요합니다.
# GitHub Actions에서는 github.token이 자동으로 GH_TOKEN/GITHUB_TOKEN에 매핑됩니다.
GH_TOKEN="github-token-for-local-use"
GITHUB_TOKEN="github-token-for-local-use"
