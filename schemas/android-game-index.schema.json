{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maynut02/astral-party-korean-patch/schemas/android-game-index.schema.json",
  "title": "Astral Party original Android APK index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "versionName",
    "versionCode",
    "certificateSha256",
    "deviceProfile",
    "releaseTag",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "const": "com.feimo.astralpartyjpn" },
    "versionName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "certificateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "deviceProfile": { "type": "string", "minLength": 1 },
    "releaseTag": { "type": "string", "pattern": "^android-game-v[0-9]+$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "splitName", "downloadUrl", "sha256", "size"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.apk$" },
          "splitName": { "type": ["string", "null"] },
          "downloadUrl": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 }
        }
      }
    }
  }
}
