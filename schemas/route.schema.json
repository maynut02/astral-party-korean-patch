{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astral-party-korean.local/schemas/route.schema.json",
  "title": "Astral Party route configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "route",
    "platform",
    "translation",
    "fonts",
    "resources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "route": {
      "$ref": "#/$defs/routeName"
    },
    "platform": {
      "enum": [
        "windows",
        "android"
      ]
    },
    "translation": {
      "type": "object",
      "required": [
        "sourceRoute",
        "lang",
        "str"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceRoute": {
          "$ref": "#/$defs/routeName"
        },
        "lang": {
          "type": "object",
          "required": [
            "assets",
            "target"
          ],
          "additionalProperties": false,
          "properties": {
            "assets": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 4,
              "propertyNames": {
                "enum": [
                  "cn_s",
                  "en",
                  "jp",
                  "cn_t"
                ]
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "target": {
              "$ref": "#/$defs/languageCode"
            }
          }
        },
        "str": {
          "type": "object",
          "required": [
            "catalogKey",
            "assetPrefix",
            "targetField"
          ],
          "additionalProperties": false,
          "properties": {
            "catalogKey": {
              "type": "string",
              "minLength": 1
            },
            "assetPrefix": {
              "type": "string",
              "minLength": 1
            },
            "targetField": {
              "$ref": "#/$defs/languageCode"
            }
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "required": [
        "tmp",
        "legacy"
      ],
      "additionalProperties": false,
      "properties": {
        "tmp": {
          "$ref": "#/$defs/tmpFontTarget"
        },
        "legacy": {
          "$ref": "#/$defs/legacyFontTarget"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "root"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "routeName": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "languageCode": {
      "enum": [
        "cn_s",
        "en",
        "jp",
        "cn_t"
      ]
    },
    "tmpFontTarget": {
      "type": "object",
      "required": [
        "catalogKey",
        "asset"
      ],
      "additionalProperties": false,
      "properties": {
        "catalogKey": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "legacyFontTarget": {
      "type": "object",
      "required": [
        "asset"
      ],
      "additionalProperties": false,
      "properties": {
        "asset": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
