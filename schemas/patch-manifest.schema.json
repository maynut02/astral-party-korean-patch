{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://astral-party-korean.local/schemas/patch-manifest.schema.json",
  "title": "Astral Party Korean patch manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "patch",
    "game",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "patch": {
      "type": "object",
      "required": [
        "version",
        "channel",
        "route",
        "buildId",
        "translationFingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "preview",
            "stable"
          ]
        },
        "route": {
          "type": "string",
          "minLength": 1
        },
        "buildId": {
          "type": "string",
          "minLength": 1
        },
        "translationFingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "game": {
      "type": "object",
      "required": [
        "version",
        "revision",
        "catalogHash"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "catalogHash": {
          "$ref": "#/$defs/catalogHash"
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "file": {
      "type": "object",
      "required": [
        "target",
        "path",
        "operation",
        "downloadUrl",
        "downloadSha256",
        "downloadSize",
        "compression",
        "sha256",
        "size"
      ],
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "addressables",
            "game-data"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "(^/|(^|/)\\.\\.(/|$))"
          }
        },
        "operation": {
          "enum": [
            "create",
            "replace"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "downloadUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "minLength": 1
        },
        "downloadSha256": {
          "$ref": "#/$defs/sha256"
        },
        "downloadSize": {
          "type": "integer",
          "minimum": 1
        },
        "compression": {
          "const": "gzip"
        }
      }
    },
    "catalogHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    }
  }
}
