{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astral Party Korean Patcher",
  "version": "0.1.0",
  "identifier": "dev.maynut.astral-party-korean-patcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Astral Party Korean Patcher",
        "width": 820,
        "height": 650,
        "minWidth": 680,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
